{
  "name": "merited",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm -r test",
    "trio:contract-test": "pnpm --filter @merited/trio contract-test",
    "lint": "eslint .",
    "typecheck": "tsc -b --dry",
    "db:migrate": "pnpm -r --workspace-concurrency=1 run db:migrate",
    "seed": "pnpm --filter @merited/seed seed",
    "verify-chain": "pnpm -r run verify-chain",
    "projections:rebuild": "pnpm -r run projections:rebuild"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "^9.30.0",
    "prettier": "^3.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.35.0",
    "vitest": "catalog:"
  }
}
