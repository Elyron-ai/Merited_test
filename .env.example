# Merited local environment (FND-2). Copy to .env — never commit .env.
# The typed env loader (FND-3, packages/contracts) fails fast on missing vars.

# dev | test | demo | prod — gates test-only overrides like MERITED_QUOTE_TTL_S (SYN-30)
MERITED_ENV=dev

# Postgres (docker-compose) — two roles per D8
MERITED_DATABASE_URL=postgres://merited_app:merited_app_dev@localhost:5432/merited
MERITED_DATABASE_ADMIN_URL=postgres://merited_migrate:merited_migrate_dev@localhost:5432/merited

# Redis — replay fast-path + rate limits only; never a source of truth
MERITED_REDIS_URL=redis://localhost:6379

# Local KMS (nsmithuk/local-kms) — target for the real Signer (PH1-30); FakeSigner ignores it
MERITED_KMS_ENDPOINT=http://localhost:4599

# Mailpit (Mailer fake)
MERITED_SMTP_URL=smtp://localhost:1025
MERITED_MAILPIT_URL=http://localhost:8025

# FakeSigner determinism secret (Phase 0 pseudo-signatures — not a real key)
MERITED_FAKE_SIGNER_SECRET=dev-fake-signer-secret

# Trio base URL (simulators in Phase 0)
MERITED_TRIO_URL=http://localhost:4010

# Optional: short quote TTL for demo negative cases (rejected outside dev/test/demo)
# MERITED_QUOTE_TTL_S=900
